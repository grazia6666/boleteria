  {
   "type": "table",
   "title": "Ahora: cada servicio, en el orden de la cadena de llamadas",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "description": "Estado: verde normal; naranja el modelo predice un cuello de botella en los proximos 30 s; rojo cuello de botella real; morado en alarma pero espera a otro servicio (el aviso queda en la causa). Alarma encendida hace: segundos desde que el modelo encendio la alarma. Ultimo cuello: cuanto antes aviso el modelo la ultima vez que el servicio entro en cuello de botella.",
   "gridPos": {
    "x": 0,
    "y": 4,
    "w": 24,
    "h": 8
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "refId": "A",
     "expr": "max by (servicio) (boleteria_orden{job=\"$job\"})",
     "format": "table",
     "instant": true
    },
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "refId": "B",
     "expr": "max by (servicio) (boleteria_estado{job=\"$job\"})",
     "format": "table",
     "instant": true
    },
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "refId": "C",
     "expr": "max by (servicio) (boleteria_probabilidad{job=\"$job\"})",
     "format": "table",
     "instant": true
    },
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "refId": "D",
     "expr": "max by (servicio) (boleteria_cpu{job=\"$job\"})",
     "format": "table",
     "instant": true
    },
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "refId": "E",
     "expr": "max by (servicio) (boleteria_alarma_cpu{job=\"$job\"})",
     "format": "table",
     "instant": true
    },
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "refId": "F",
     "expr": "max by (servicio) (boleteria_p95_ms{job=\"$job\"})",
     "format": "table",
     "instant": true
    },
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "refId": "G",
     "expr": "max by (servicio) (boleteria_cola{job=\"$job\"})",
     "format": "table",
     "instant": true
    },
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "refId": "H",
     "expr": "max by (servicio) (boleteria_alarma_hace_s{job=\"$job\"})",
     "format": "table",
     "instant": true
    },
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "refId": "I",
     "expr": "max by (servicio, causa) (boleteria_causa{job=\"$job\"})",
     "format": "table",
     "instant": true
    },
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "refId": "K",
     "expr": "max by (servicio, modelo) (boleteria_ultimo_aviso{job=\"$job\"})",
     "format": "table",
     "instant": true
    }
   ],
   "transformations": [
    {
     "id": "joinByField",
     "options": {
      "byField": "servicio",
      "mode": "outer"
     }
    },
    {
     "id": "filterFieldsByName",
     "options": {
      "include": {
       "pattern": "^(servicio|Value #[A-H]|causa|modelo)$"
      }
     }
    },
    {
