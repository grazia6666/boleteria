  {
   "type": "table",
   "title": "Eventos de esta carga (el más reciente arriba)",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "description": "Los mismos mensajes de la pantalla de python ml/demo.py.",
   "gridPos": {
    "x": 0,
    "y": 12,
    "w": 12,
    "h": 11
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "refId": "A",
     "expr": "last_over_time(boleteria_evento{job=\"$job\"}[30m]) * on(sesion) group_left() boleteria_sesion{job=\"$job\"}",
     "format": "table",
     "instant": true
    }
   ],
   "transformations": [
    {
     "id": "organize",
     "options": {
      "excludeByName": {
       "Time": true,
       "instance": true,
       "job": true,
       "__name__": true,
       "n": true,
       "sesion": true
      },
      "indexByName": {
       "Value": 0,
       "tipo": 1,
       "texto": 2
      },
      "renameByName": {
       "Value": "t",
       "tipo": "Qué pasó",
       "texto": "Detalle"
      }
     }
    },
    {
     "id": "sortBy",
     "options": {
      "sort": [
       {
        "field": "t",
        "desc": true
       }
      ]
     }
    }
   ],
   "fieldConfig": {
    "defaults": {
     "custom": {
      "align": "left"
     }
    },
    "overrides": [
     {
      "matcher": {
       "id": "byName",
       "options": "t"
      },
      "properties": [
       {
        "id": "unit",
        "value": "suffix: s"
       },
       {
        "id": "decimals",
        "value": 0
       },
       {
        "id": "custom.width",
        "value": 70
       }
      ]
     },
     {
      "matcher": {
       "id": "byName",
       "options": "Detalle"
      },
      "properties": [
       {
        "id": "custom.cellOptions",
        "value": {
         "type": "auto",
         "wrapText": true
        }
       }
      ]
     },
     {
      "matcher": {
       "id": "byName",
       "options": "Qué pasó"
      },
      "properties": [
       {
        "id": "custom.width",
        "value": 175
       },
       {
        "id": "custom.cellOptions",
        "value": {
         "type": "color-background"
        }
       },
       {
        "id": "mappings",
        "value": [
         {
          "type": "value",
          "options": {
           "aviso": {
            "text": "⚠ el modelo avisa",
            "color": "#E07B1F",
            "index": 0
           }
          }
         },
         {
          "type": "value",
          "options": {
           "cuello": {
            "text": "✖ cuello de botella",
            "color": "#C0322B",
            "index": 1
           }
          }
         },
         {
          "type": "value",
